# Local Claude settings (project-specific, not for repo)
.claude/

# Manuscript working copy is not part of this repository.
paper/

# Books directory holds copyrighted PDFs (Sipser, ESLII, …) plus
# their generated sidecars and rendered figures.  Source PDFs are
# never to be redistributed; the sidecars are also too large for
# the repo.  Re-run ``tools/extract_book_figures``,
# ``tools/build_chapter_map``, etc. locally to rebuild them from
# your own copy of the book.
books/

# Local persisted session snapshots — per-user state, never share.
.sevim/

# Old drafts (LaTeX intermediates etc.).
old/

# Pytest cache.
.pytest_cache/

# Inspector / smoke-test artifacts (regenerable, not source).
health/

# Private teaching-corpus extraction (contains student identifiers — do
# NOT commit; it was used only during the design phase to validate the
# relation-grammar choices, and is not required to reproduce any
# reported result).
discovery/triples.jsonl

# Local environment files (may hold API keys).
.env
.env*

# Linter / type-checker caches.
.ruff_cache/
.mypy_cache/

# Output of tools/capture_*_screenshots.py and tools/record_narration.py.
screenshots/
